# Copy to .env and fill in only what this node needs. The file is gitignored.
#
# Comma-separated relayer private keys. Leave empty for a manual gateway that
# only admits/forwards frame transactions and never relays them itself.
# SKANDHA_RELAYERS=
#
# Optional overrides. The config.json in this directory already points at the
# public altmempool execution client.
# SKANDHA_RPC=https://altmempool.forshtat.com
# SKANDHA_RPC_SUBMIT=https://altmempool.forshtat.com
#
# Optional explorer faucet (also requires --explorer.enable in the command).
# SKANDHA_FAUCET_KEY=
